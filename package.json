{
  "name": "petitmaker",
  "private": true,
  "version": "2.1.1185",
  "type": "module",
  "homepage": "https://petitmaker.cc/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stry233/PetitMaker.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && npm run build:web",
    "build:web": "vite build && vite-node scripts/build-legal-pages.mts",
    "stamp": "vite-node scripts/stamp-build.mts",
    "hooks:install": "git config core.hooksPath .githooks && node scripts/internal/worktree/setup.mts",
    "stamp:check": "vite-node scripts/stamp-build.mts --check",
    "build:release": "npm run legal:validate && npm run stamp:check && tsc -p tsconfig.json && vite build && PETIT_RELEASE=1 vite-node scripts/build-legal-pages.mts",
    "preview": "vite preview",
    "test": "vitest --project 'unit-*'",
    "test:run": "vitest run --project 'unit-*'",
    "test:slow": "vitest run --project slow",
    "test:all": "vitest run --project 'unit-*' --project slow",
    "test:spec": "vitest run --project 'unit-*' --project slow src/__tests__/spec",
    "spec:report": "node scripts/spec-report.mts",
    "check": "npm run lint && npm run lint:exports && npm run guards && npm run build:web && npm run test:run",
    "preflight": "node scripts/internal/publish/preflight.mts",
    "test:related": "vitest related --run --project 'unit-*'",
    "test:changed": "vitest run --project 'unit-*' --changed",
    "test:e2e": "vitest run --project e2e --no-file-parallelism",
    "test:journeys": "vitest run --project e2e src/__tests__/e2e/journey-smoke.e2e.internal.test.ts",
    "test:perf": "PETIT_PERF=1 vitest run --project perf --no-file-parallelism",
    "lint": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json && tsc -p src/__tests__/tsconfig.json && eslint --cache --cache-location node_modules/.cache/eslint/ src scripts security vite.config.ts vitest.config.ts",
    "lint:exports": "[ ! -d scripts/internal ] || npx --yes knip@5.88.1",
    "guards": "[ ! -d scripts/internal ] || (node scripts/internal/guards/changelog-entries.mts && node scripts/internal/guards/spec-requirements.mts && node scripts/internal/guards/allowlist-growth.mts && node scripts/internal/guards/number-spec-ids.mts --check && node scripts/internal/guards/rig-imports.mts)",
    "docs:generate": "vite-node scripts/generate-reference.mts",
    "docs:check": "vite-node scripts/generate-reference.mts --check",
    "legal:licenses": "vite-node scripts/license-audit.mts",
    "legal:licenses:check": "vite-node scripts/license-audit.mts --check",
    "legal:headers": "vite-node scripts/generate-headers.mts",
    "legal:headers:check": "vite-node scripts/generate-headers.mts --check",
    "legal:validate": "vite-node scripts/validate-legal-release.mts",
    "dev:lite": "vite --mode lite",
    "build:lite": "tsc -p tsconfig.json && vite build --mode lite && vite-node scripts/package-lite.mts"
  },
  "dependencies": {
    "@2toad/profanity": "3.3.0",
    "@anthropic-ai/sdk": "^0.124.0",
    "@pixi/unsafe-eval": "^7.4.3",
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "clipper-lib": "6.4.2",
    "cuss": "2.2.0",
    "earcut": "^3.2.4",
    "fflate": "0.8.3",
    "framer-motion": "^12.43.0",
    "linkify-it": "6.1.0",
    "naughty-words": "1.2.0",
    "nsfwjs": "4.4.0",
    "obscenity": "0.4.6",
    "onnxruntime-web": "1.29.0",
    "openai": "^6.42.0",
    "opencc-js": "1.4.2",
    "pixi.js-legacy": "^7.4.3",
    "qrcode-generator": "^2.0.4",
    "re2js": "2.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "6.0.1",
    "three": "^0.169.0",
    "tlds": "1.261.0",
    "wasm-feature-detect": "1.10.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/earcut": "^3.2.4",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "pinyin-pro": "3.29.5",
    "regexpu-core": "^6.5.4",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-node": "6.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "qs": "6.16.1"
  }
}
