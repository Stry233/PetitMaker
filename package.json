{
  "name": "petitmaker",
  "private": true,
  "version": "1.0.44",
  "type": "module",
  "homepage": "https://petitmaker.cc/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stry233/PetitMaker.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite-node scripts/build-legal-pages.mts",
    "stamp": "vite-node scripts/stamp-build.mts",
    "hooks:install": "git config core.hooksPath .githooks && echo 'git hooks enabled (.githooks)'",
    "stamp:check": "vite-node scripts/stamp-build.mts --check",
    "build:release": "npm run legal:validate && npm run stamp:check && tsc -b && vite build && PETIT_RELEASE=1 vite-node scripts/build-legal-pages.mts",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "perf": "PETIT_PERF=1 vitest run --no-file-parallelism src/__tests__/perf",
    "lint": "tsc --noEmit",
    "docs:generate": "vite-node scripts/generate-reference.mts",
    "docs:check": "vite-node scripts/generate-reference.mts --check",
    "legal:licenses": "vite-node scripts/license-audit.mts",
    "legal:licenses:check": "vite-node scripts/license-audit.mts --check",
    "legal:headers": "vite-node scripts/generate-headers.mts",
    "legal:headers:check": "vite-node scripts/generate-headers.mts --check",
    "legal:validate": "vite-node scripts/validate-legal-release.mts"
  },
  "dependencies": {
    "@2toad/profanity": "3.3.0",
    "@anthropic-ai/sdk": "^0.124.0",
    "@pixi/unsafe-eval": "^7.4.3",
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "cuss": "2.2.0",
    "earcut": "^3.2.3",
    "fflate": "0.8.3",
    "framer-motion": "^12.43.0",
    "linkify-it": "6.1.0",
    "naughty-words": "1.2.0",
    "nsfwjs": "4.4.0",
    "obscenity": "0.4.6",
    "onnxruntime-web": "^1.29.0",
    "openai": "^6.42.0",
    "opencc-js": "1.4.2",
    "pixi.js-legacy": "^7.4.3",
    "qrcode-generator": "^2.0.4",
    "re2js": "2.8.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "6.0.1",
    "three": "^0.169.0",
    "tlds": "1.261.0",
    "wasm-feature-detect": "1.9.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/earcut": "^3.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "pinyin-pro": "3.29.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vite-node": "2.1.9",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
