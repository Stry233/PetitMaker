{
  // Cloudflare Workers static-asset hosting for the production site. `name` must equal the
  // Worker's name in the Cloudflare dashboard or the build fails before it runs.
  // The Worker consolidates origins and HTML aliases before static assets are served.
  // Response headers come from public/_headers, generated from security/headers-policy.ts.
  "name": "petitmaker",
  "compatibility_date": "2026-07-30",
  "main": "./security/site-worker.ts",
  "routes": [
    { "pattern": "petitmaker.cc", "custom_domain": true },
    { "pattern": "www.petitmaker.cc", "custom_domain": true },
    { "pattern": "petit-maker.com", "custom_domain": true },
    { "pattern": "www.petit-maker.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
