{
  "name": "PetitMaker",
  "short_name": "PetitMaker",
  "description": "PetitMaker is a free online map editor and planet planner for Petit Planet. Design terrain, waterways, roads and buildings, then preview, save and share your planet in 2D or 3D.",
  "lang": "en",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "landscape",
  "background_color": "#FFFBE1",
  "theme_color": "#FFFBE1",
  "icons": [
    {
      "src": "logo-256.png",
      "sizes": "256x256",
      "type": "image/png"
    },
    {
      "src": "apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ]
}
